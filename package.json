{
  "name": "platino",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "turbo run dev",
    "dev:merchant": "turbo run dev --filter=merchant",
    "dev:user": "turbo run dev --filter=user",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "build:merchant": "turbo run build --filter=merchant",
    "build:user": "turbo run build --filter=user",
    "build:admin": "turbo run build --filter=admin",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.5"
  }
}
