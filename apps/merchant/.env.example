# Optional: leave empty to use same-origin OTP routes in Lovable preview/publish.
# Set only if you deploy and want to call a separate backend.
# VITE_API_URL=https://your-backend.example.com

# Resend email OTP configuration for same-origin server routes.
# Use onboarding@resend.dev for testing, then switch to a verified sender in production.
RESEND_API_KEY=re_your_key_here
RESEND_FROM="Platino Pharma <onboarding@resend.dev>"

# OTP tuning
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_ACCEPT_ANY=true

# Abuse protection tuning
OTP_RATE_WINDOW_SECONDS=900
OTP_RATE_LIMIT_IP=20
OTP_RATE_LIMIT_EMAIL=5
OTP_VERIFY_RATE_WINDOW_SECONDS=900
OTP_VERIFY_RATE_LIMIT_IP=40
OTP_VERIFY_RATE_LIMIT_EMAIL=10

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=