# ==========================================
# Platino Turborepo Monorepo .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
dist/
build/
out/

# TypeScript build info
*.tsbuildinfo

# Turborepo cache
.turbo/

# Testing
coverage/
playwright-report/
test-results/
.playwright/

# Environment files — never commit real secrets
.env
.env.local
.env.development
.env.production
.env.development.local
.env.test.local
.env.production.local

# Only example/template env files are safe to commit
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package manager lock files (using pnpm)
package-lock.json
yarn.lock

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Vercel
.vercel

# Next.js
/apps/*/.next/
/apps/*/out/

# Debug
npm-debug.log*
pnpm-debug.log*
